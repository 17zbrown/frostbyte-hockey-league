# Dependencies
node_modules/

# Secrets — never commit API keys
.env
.env.*
!.env.example

# Netlify local state
.netlify/

# Editor / OS
.DS_Store
.claude/

# Local reference material (not needed for the site)
*.pdf

# Logs
*.log
npm-debug.log*

# Build output — generated from src/live/ by build.cjs.
# index.html is built by Netlify at deploy time (see netlify.toml); the staging/
# prototype builds aren't shipped. Keeps git history from carrying ~700KB blobs.
index.html
# v4.05: written beside index.html by the build (the build id the league pulse reads)
version.json
# v4.62: the published folder (tools/site-build.cjs writes it; netlify.toml publish = "_site")
_site/
# v4.06: the Supabase Edge bundles (node tools/edge/build.mjs) and the Supabase CLI's scratch folder
supabase/functions/
supabase/.temp/
supabase/.branches/
preview.html
chelgaming-live.html
chelgaming-preview.html
redesign-preview.html
/live*.html

# Plugin session state — churns every session, never part of the site
**/.claude-flow/
tools/demo/_guide_bundle.js
tools/guides/shots/
docs/guides/_shots-*.json
docs/guides/_report.json
tools/guides/shots-phone/
docs/guides/phone/_render-*.json
docs/guides/phone/_report.json
tools/guides/src-phone/
docs/guides/pages/_shots-*.json
docs/guides/pages/_report.json

# graphify knowledge graph output (local only)
graphify-out/
# v5.00 swap: the S2 concept's real-data snapshot, logos copy, deploy state and share copies never enter git
src/s2/data/
# no trailing slash: run.cjs makes src/s2/assets a symlink, and "dir/" patterns never match a link
src/s2/assets
snapshot.js
src/s2/site/
src/s2/share.html
src/s2/share-files.json
src/s2/.site-id
src/s2/.deployed
src/s2/.published
src/s2/.edge-hash
_site/
